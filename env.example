# =============================================================
#   IBM WATSONX / GRANITE CONFIGURATION
# =============================================================
# IBM Cloud API Key – generate at https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# IBM Watson Studio / WatsonX project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX.ai API endpoint (region-specific)
# US-South: https://us-south.ml.cloud.ibm.com
# EU-DE:    https://eu-de.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model IDs (Lite tier – free)
# Primary LLM: Granite 13B Chat v2
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Granite 3B for faster/lighter inference
GRANITE_INSTRUCT_MODEL_ID=ibm/granite-3-8b-instruct

# =============================================================
#   RAG / VECTOR STORE CONFIGURATION
# =============================================================
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Embedding model (runs locally – no API needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of documents to retrieve per query
RAG_TOP_K=5

# Chunk size and overlap for document splitting
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# =============================================================
#   APPLICATION CONFIGURATION
# =============================================================
# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Session secret key (change this to a random string in production)
SECRET_KEY=interview-trainer-secret-key-2024

# Maximum resume file size (bytes) – default 5 MB
MAX_FILE_SIZE=5242880

# Upload directory for resumes
UPLOAD_DIR=./data/uploads

# Interview session timeout in minutes
SESSION_TIMEOUT=60

# =============================================================
#   LLM GENERATION PARAMETERS
# =============================================================
LLM_MAX_NEW_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TOP_K=50
LLM_REPETITION_PENALTY=1.1

# =============================================================
#   LOGGING
# =============================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/interview_trainer.log
